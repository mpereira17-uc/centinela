<?xml version="1.0" encoding="utf-8"?>
<!-- Tarjeta que aparece encima de la pantalla de llamada entrante, como la de un identificador de llamadas -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/tarjeta"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/fondo_tarjeta"
    android:elevation="12dp"
    android:orientation="vertical"
    android:paddingBottom="16dp">

    <TextView
        android:id="@+id/tarjeta_franja"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/franja_alto"
        android:paddingHorizontal="20dp"
        android:paddingVertical="6dp"
        android:text="@string/tarjeta_franja"
        android:textColor="@color/marino"
        android:textSize="13sp"
        android:textStyle="bold" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="20dp"
        android:paddingTop="14dp">

        <ImageView
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_buho_tarjeta" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tarjeta_titulo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="#FFFFFF"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tarjeta_numero"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="#C9D3E0"
                android:textSize="15sp" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/tarjeta_cerrar"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@android:color/transparent"
            android:contentDescription="@string/tarjeta_cerrar"
            android:src="@android:drawable/ic_menu_close_clear_cancel"
            android:tint="#C9D3E0" />
    </LinearLayout>

    <TextView
        android:id="@+id/tarjeta_texto"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:paddingHorizontal="20dp"
        android:textColor="#FFFFFF"
        android:textSize="15sp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:paddingHorizontal="20dp"
        android:text="@string/tarjeta_pie"
        android:textColor="#C9D3E0"
        android:textSize="13sp" />
</LinearLayout>
